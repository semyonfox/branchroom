<nav id="navbar" aria-label="{{ctx.Locale.Tr "aria.navbar"}}">
	<a class="item" id="navbar-logo" href="{{AppSubUrl}}/" aria-label="{{if .IsSigned}}{{ctx.Locale.Tr "dashboard"}}{{else}}{{ctx.Locale.Tr "home_title"}}{{end}}">
		<span class="forge-mark" aria-hidden="true"></span><span class="forge-wordmark">{{AppName}}</span>
	</a>

	<form class="forge-search" id="forge-palette-trigger" action="{{AppSubUrl}}/explore/repos" role="search">
		<label class="global-shortcut-wrapper">
			{{svg "octicon-search"}}
			<input type="search" name="q" aria-haspopup="dialog" aria-controls="forge-palette" aria-keyshortcuts="Control+K Meta+K" aria-label="{{ctx.Locale.Tr "forge.search"}}" placeholder="{{ctx.Locale.Tr "forge.search"}}">
			<kbd data-global-init="onGlobalShortcut" data-shortcut-keys="/">/</kbd>
		</label>
	</form>
	<dialog id="forge-palette" class="forge-palette"
		aria-label="{{ctx.Locale.Tr "forge.palette.title"}}"
		data-repo-link="{{.RepoLink}}"
		data-signed-in="{{.IsSigned}}"
		{{if .Repository}}data-default-branch="{{.Repository.DefaultBranch}}"{{end}}
		data-recent="{{ctx.Locale.Tr "forge.palette.recent"}}"
		data-repositories="{{ctx.Locale.Tr "forge.palette.repositories"}}"
		data-files="{{ctx.Locale.Tr "forge.palette.files"}}"
		data-issues="{{ctx.Locale.Tr "forge.palette.issues"}}"
		data-commands="{{ctx.Locale.Tr "forge.palette.commands"}}"
		data-inbox="{{ctx.Locale.Tr "forge.inbox"}}"
		data-inbox-detail="{{ctx.Locale.Tr "forge.palette.inbox_detail"}}"
		data-notifications="{{ctx.Locale.Tr "notifications"}}"
		data-explore="{{ctx.Locale.Tr "explore_title"}}"
		data-explore-detail="{{ctx.Locale.Tr "forge.palette.explore_detail"}}"
		data-settings="{{ctx.Locale.Tr "forge.palette.your_settings"}}"
		data-settings-detail="{{ctx.Locale.Tr "forge.palette.settings_detail"}}"
		data-repo-settings="{{ctx.Locale.Tr "forge.palette.repo_settings"}}"
		data-new-repository="{{ctx.Locale.Tr "new_repo"}}"
		data-new-issue="{{ctx.Locale.Tr "repo.issues.new"}}"
		data-empty="{{ctx.Locale.Tr "forge.palette.empty"}}"
		data-loading="{{ctx.Locale.Tr "forge.palette.loading"}}"
		data-error="{{ctx.Locale.Tr "forge.palette.error"}}"
		data-hint="{{ctx.Locale.Tr "forge.palette.hint"}}"
	></dialog>
	{{if and .IsSigned (not .MustChangePassword)}}
		{{template "base/head_navbar_icons"}}
		{{if not ctx.Consts.RepoUnitTypePullRequests.UnitGlobalDisabled}}
			<a aria-label="{{ctx.Locale.Tr "pull_requests"}}" class="item forge-pulls{{if .PageIsPulls}} active{{end}}" href="{{AppSubUrl}}/pulls">{{svg "octicon-git-pull-request"}}<span>{{ctx.Locale.Tr "pull_requests"}}</span></a>
		{{end}}
	{{else if not .IsSigned}}
		<a class="item forge-explore{{if .PageIsExplore}} active{{end}}" href="{{AppSubUrl}}/explore/repos">{{ctx.Locale.Tr "explore_title"}}</a>
	{{end}}

	<div class="navbar-list navbar-right">
		{{if and .IsSigned .MustChangePassword}}
			<div class="ui dropdown jump item" data-tooltip-content="{{ctx.Locale.Tr "user_profile_and_more"}}">
				<span class="flex-text-block">
					{{ctx.AvatarUtils.Avatar .SignedUser 24}}
				</span>
				<div class="menu user-menu">
					<div class="header">
						{{ctx.Locale.Tr "signed_in_as"}} <strong>{{.SignedUser.Name}}</strong>
					</div>

					<div class="divider"></div>
					<a class="item" href="{{AppSubUrl}}/user/logout">
						{{svg "octicon-sign-out"}}
						{{ctx.Locale.Tr "sign_out"}}
					</a>
				</div><!-- end content avatar menu -->
			</div><!-- end dropdown avatar menu -->
		{{else if .IsSigned}}
			<div class="ui dropdown jump item" data-tooltip-content="{{ctx.Locale.Tr "create_new"}}">
				<span class="flex-text-block">
					{{svg "octicon-plus"}}
				</span>
				<div class="menu">
					<a class="item" href="{{AppSubUrl}}/repo/create">
						{{svg "octicon-plus"}} {{ctx.Locale.Tr "new_repo"}}
					</a>
					{{if not .DisableMigrations}}
						<a class="item" href="{{AppSubUrl}}/repo/migrate">
							{{svg "octicon-repo-push"}} {{ctx.Locale.Tr "new_migrate"}}
						</a>
					{{end}}
					{{if .SignedUser.CanCreateOrganization}}
					<a class="item" href="{{AppSubUrl}}/org/create">
						{{svg "octicon-organization"}} {{ctx.Locale.Tr "new_org"}}
					</a>
					{{end}}
				</div><!-- end content create new menu -->
			</div><!-- end dropdown menu create new -->

			<div class="ui dropdown jump item" data-tooltip-content="{{ctx.Locale.Tr "user_profile_and_more"}}" data-signed-in-username="{{.SignedUser.Name}}">
				<span class="flex-text-block">
					<span class="navbar-avatar">
						{{ctx.AvatarUtils.Avatar .SignedUser 24}}
						{{if .IsAdmin}}{{svg "octicon-shield-check" 16 "navbar-admin-badge"}}{{end}}
					</span>
				</span>
				<div class="menu user-menu">
					<div class="header">
						{{ctx.Locale.Tr "signed_in_as"}} <strong>{{.SignedUser.Name}}</strong>
					</div>

					<div class="divider"></div>
					<a class="item" href="{{AppSubUrl}}/explore/repos">{{svg "octicon-telescope"}} {{ctx.Locale.Tr "explore_title"}}</a>
					{{if not ctx.Consts.RepoUnitTypeIssues.UnitGlobalDisabled}}
						<a class="item" href="{{AppSubUrl}}/issues">{{svg "octicon-issue-opened"}} {{ctx.Locale.Tr "issues"}}</a>
					{{end}}
					<a class="item" href="{{.SignedUser.HomeLink}}">
						{{svg "octicon-person"}}
						{{ctx.Locale.Tr "your_profile"}}
					</a>
					{{if not .DisableStars}}
						<a class="item" href="{{.SignedUser.HomeLink}}?tab=stars">
							{{svg "octicon-star"}}
							{{ctx.Locale.Tr "your_starred"}}
						</a>
					{{end}}
					<a class="item" href="{{AppSubUrl}}/notifications/subscriptions">
						{{svg "octicon-bell"}}
						{{ctx.Locale.Tr "notification.subscriptions"}}
					</a>
					<a class="{{if .PageIsUserSettings}}active {{end}}item" href="{{AppSubUrl}}/user/settings">
						{{svg "octicon-tools"}}
						{{ctx.Locale.Tr "your_settings"}}
					</a>
					<a class="item" target="_blank" href="https://docs.gitea.com">
						{{svg "octicon-question"}}
						{{ctx.Locale.Tr "help"}}
					</a>
					{{if .IsAdmin}}
					<div class="divider"></div>
					<a class="{{if .PageIsAdmin}}active {{end}}item" href="{{AppSubUrl}}/-/admin">
						{{svg "octicon-server"}}
						{{ctx.Locale.Tr "admin_panel"}}
					</a>
					{{end}}
					<div class="divider"></div>
					<a class="item" href="{{AppSubUrl}}/user/logout">
						{{svg "octicon-sign-out"}}
						{{ctx.Locale.Tr "sign_out"}}
					</a>
				</div><!-- end content avatar menu -->
			</div><!-- end dropdown avatar menu -->
		{{else}}
			<a class="item{{if .PageIsSignIn}} active{{end}}" rel="nofollow" href="{{AppSubUrl}}/user/login">
				{{svg "octicon-sign-in"}}
				<span class="tw-ml-1">{{ctx.Locale.Tr "sign_in"}}</span>
			</a>
		{{end}}
	</div>
</nav>
{{template "base/head_impersonate_banner"}}
{{template "base/head_banner"}}
