<tr>
	<td>{{if .IsTeam}}{{svg "octicon-people"}} {{end}}{{.Name}}</td>
	<td>{{.Access}}</td>
	<td>{{template "repo/settings/branchroom_grant_expiry" .Grant}}</td>
	<td>
		<div class="flex-text-block tw-justify-end">
			<button type="button" class="ui tiny basic button show-modal" data-modal="#branchroom-renew-{{.ModalID}}">{{ctx.Locale.Tr "repo.settings.branchroom.renew_grant"}}</button>
			<dialog class="modal-dialog" id="branchroom-renew-{{.ModalID}}">
				<div class="header">{{ctx.Locale.Tr "repo.settings.branchroom.renew_grant"}}</div>
				<form class="ui form" action="{{.RenewURL}}" method="post">
					<div class="content required field">
						<label for="branchroom-renew-expiry-{{.ModalID}}">{{ctx.Locale.Tr "repo.settings.branchroom.grant_expires"}}</label>
						<input id="branchroom-renew-expiry-{{.ModalID}}" type="datetime-local" name="expires" value="{{.Expiry}}" required>
					</div>
					{{template "base/modal_actions_confirm" (dict "ModalButtonTypes" "confirm" "ModalButtonOkText" (ctx.Locale.Tr "repo.settings.branchroom.renew_grant"))}}
				</form>
			</dialog>
			<form action="{{.RevokeURL}}" method="post">
				<button type="submit" class="ui red basic tiny button">{{ctx.Locale.Tr "repo.settings.branchroom.access_remove"}}</button>
			</form>
		</div>
	</td>
</tr>
