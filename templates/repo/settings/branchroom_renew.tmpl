<button type="button" class="ui tiny basic button show-modal" data-modal="#branchroom-renew-{{.GrantID}}">{{ctx.Locale.Tr "repo.settings.branchroom.renew_grant"}}</button>
<dialog class="modal-dialog" id="branchroom-renew-{{.GrantID}}">
    <div class="header">{{ctx.Locale.Tr "repo.settings.branchroom.renew_grant"}}</div>
    <form class="ui form" action="{{.RepoLink}}/settings/branchroom/scopes/{{.ScopeID}}/grants/{{.GrantID}}/renew" method="post">
        <div class="content required field">
            <label for="branchroom-renew-expiry-{{.GrantID}}">{{ctx.Locale.Tr "repo.settings.branchroom.grant_expires"}}</label>
            <input id="branchroom-renew-expiry-{{.GrantID}}" type="datetime-local" name="expires" value="{{.Expiry}}" required>
        </div>
        {{template "base/modal_actions_confirm" (dict "ModalButtonTypes" "confirm" "ModalButtonOkText" (ctx.Locale.Tr "repo.settings.branchroom.renew_grant"))}}
    </form>
</dialog>
