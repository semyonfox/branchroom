{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository branchroom-source-handoffs">
	{{template "repo/header" .}}
	<div class="ui container">
		{{template "base/alert" .}}
		<h4 class="ui top attached header">{{ctx.Locale.Tr "repo.branchroom.source_handoffs"}}</h4>
		<div class="ui attached segment">
			<p>{{ctx.Locale.Tr "repo.branchroom.source_handoffs_desc"}}</p>
			<div class="ui warning message">{{ctx.Locale.Tr "repo.branchroom.source_handoffs_auth"}}</div>
			<div class="ui list">
				{{range $index, $handoff := .BranchroomSourceHandoffs}}
					<div class="item">
						<div class="item-title">{{$handoff.ScopeName}}</div>
						<div class="ui small action input tw-mt-2 tw-w-full">
							<input id="branchroom-source-clone-{{$index}}" value="{{$handoff.CloneURL}}" readonly>
							<button class="ui icon button" data-clipboard-target="#branchroom-source-clone-{{$index}}" data-tooltip-content="{{ctx.Locale.Tr "copy_url"}}">
								{{svg "octicon-copy" 14}}
							</button>
						</div>
					</div>
				{{end}}
			</div>
		</div>
	</div>
</div>
{{template "base/footer" .}}
