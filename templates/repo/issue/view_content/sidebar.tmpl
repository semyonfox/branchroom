<div class="issue-content-right forge-side-lists" id="conversation-details" data-global-init="initRepoIssueSidebar">
	{{template "custom/extra_repo_issue_sidebar_top" $}}
	{{template "repo/issue/branch_selector_field" $}}

	{{/* readers only see sections that have something in them, editors keep every picker */}}
	{{$meta := $.IssuePageMetaData}}
	{{$canEdit := $meta.CanModifyIssueOrPull}}
	{{if .Issue.IsPull}}
		{{$reviewers := $meta.ReviewersData}}
		{{if or $reviewers.CanChooseReviewer $reviewers.OriginalReviews $reviewers.CurrentPullReviewers}}
			{{template "repo/issue/sidebar/reviewer_list" $meta}}
		{{end}}
		{{if .IsIssuePoster}}{{template "repo/issue/sidebar/wip_switch" $}}{{end}}
	{{template "repo/issue/view_content/side_checks" $.Conversation}}
		<div class="divider"></div>
	{{end}}

	{{if .Conversation.Linked}}<section class="forge-linked-list"><strong>{{ctx.Locale.Tr "repo.conversation.linked"}}</strong>{{range .Conversation.Linked}}<a class="tw-block tw-py-2" href="{{.Link}}">#{{.Index}} {{.Title}}</a>{{end}}</section>{{end}}
	{{if or $canEdit .Issue.Labels}}
		{{template "repo/issue/sidebar/label_list" $meta}}
	{{end}}
	{{if or $canEdit .Issue.Milestone}}
		{{template "repo/issue/sidebar/milestone_list" $meta}}
	{{end}}
	{{if and .IsProjectsEnabled (or $canEdit $meta.ProjectsData.SelectedProjectIDs)}}
		{{template "repo/issue/sidebar/project_list" $meta}}
	{{end}}
	{{if or $canEdit .Issue.Assignees}}
		{{template "repo/issue/sidebar/assignee_list" $meta}}
	{{end}}

	{{template "repo/issue/sidebar/participant_list" $}}

	{{$timer := .Repository.IsTimetrackerEnabled ctx}}
	{{$hasTime := or .Issue.TotalTrackedTime .Issue.TimeEstimate .IsStopwatchRunning}}
	{{$deps := .Repository.IsDependenciesEnabled ctx}}
	{{$hasDeps := or .BlockedByDependencies .BlockedByDependenciesNotPermitted .BlockingDependencies .BlockingDependenciesNotPermitted}}
	{{if and $timer $hasTime}}{{template "repo/issue/sidebar/stopwatch_timetracker" $}}{{end}}
	{{if .Issue.DeadlineUnix}}
		{{template "repo/issue/sidebar/due_date" $}}
	{{end}}
	{{if and $deps $hasDeps}}{{template "repo/issue/sidebar/issue_dependencies" $}}{{end}}
	{{if and .HasIssuesOrPullsWritePermission (or (and $timer (not $hasTime)) (and $deps (not $hasDeps)))}}
		{{/* empty timer and dependency forms stay out of the way until someone needs them */}}
		<details class="forge-side-more">
			<summary>{{if and $timer (not $hasTime) $deps (not $hasDeps)}}{{ctx.Locale.Tr "repo.conversation.track_or_depend"}}{{else if and $timer (not $hasTime)}}{{ctx.Locale.Tr "repo.conversation.track_time"}}{{else}}{{ctx.Locale.Tr "repo.conversation.add_dependency"}}{{end}}</summary>
			{{if and $timer (not $hasTime)}}{{template "repo/issue/sidebar/stopwatch_timetracker" $}}{{end}}
			{{if and $deps (not $hasDeps)}}{{template "repo/issue/sidebar/issue_dependencies" $}}{{end}}
		</details>
	{{end}}

	{{template "repo/issue/sidebar/allow_maintainer_edit" $}}
	{{template "repo/issue/sidebar/watch_notification" $}}
</div>
