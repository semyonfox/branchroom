{{$props := .Props}}
{{$admin := .IsAdmin}}
<div class="item forge-merge-actions">
	{{if $props.hasPendingPullRequestMerge}}
		<div class="ui info message">{{$props.hasPendingPullRequestMergeTip}}</div>
		<form action="{{$props.baseLink}}/cancel_auto_merge" method="post">
			<button class="ui button" type="submit">{{$props.textAutoMergeCancelSchedule}}</button>
		</form>
	{{end}}
	{{range $props.mergeStyles}}
		{{if and .allowed (or (ne .name "manually-merged") $admin)}}
			{{if eq .name $props.defaultMergeStyle}}
				<button type="button" class="ui {{if and $props.canMergeNow $.Ready}}primary{{else}}basic{{end}} button show-modal" data-modal="#forge-merge-{{.name}}" data-palette-action="{{.textDoMerge}}">
					{{.textDoMerge}}{{if and (not $props.canMergeNow) (not .hideAutoMerge)}} {{$props.textAutoMergeButtonWhenSucceed}}{{end}}
				</button>
			{{end}}
			<dialog class="modal-dialog" id="forge-merge-{{.name}}">
				<div class="header">{{.textDoMerge}}</div>
				<div class="content">
					<form class="ui form form-fetch-action" action="{{$props.baseLink}}/merge" method="post">
						<input type="hidden" name="head_commit_id" value="{{$props.pullHeadCommitID}}">
						<input type="hidden" name="force_merge" value="{{and $props.canMergeNow (not $props.allOverridableChecksOk)}}">
						{{if not .hideMergeMessageTexts}}
							<div class="field"><input aria-label="{{ctx.Locale.Tr "repo.editor.commit_message_desc"}}" name="merge_title_field" value="{{.mergeTitleFieldText}}"></div>
							<div class="field"><textarea name="merge_message_field" rows="4" aria-label="{{$props.mergeMessageFieldPlaceHolder}}">{{.mergeMessageFieldText}}</textarea></div>
						{{end}}
						{{if eq .name "manually-merged"}}
							<div class="field"><input required name="merge_commit_id" placeholder="{{$props.textMergeCommitId}}" aria-label="{{$props.textMergeCommitId}}"></div>
						{{else}}
							<div class="field"><label><input type="checkbox" name="merge_when_checks_succeed" value="true" {{if not $props.canMergeNow}}checked{{end}}> {{$props.textAutoMergeWhenSucceed}}</label></div>
						{{end}}
						{{if $props.isPullBranchDeletable}}
							<div class="field"><label><input type="checkbox" name="delete_branch_after_merge" value="true" {{if $props.defaultDeleteBranchAfterMerge}}checked{{end}}> {{$props.textDeleteBranch}}</label></div>
						{{end}}
						<div class="actions">
							<button type="button" class="ui cancel button">{{$props.textCancel}}</button>
							<button type="submit" class="ui primary button" name="do" value="{{.name}}">{{.textDoMerge}}</button>
						</div>
					</form>
				</div>
			</dialog>
		{{end}}
	{{end}}
</div>
