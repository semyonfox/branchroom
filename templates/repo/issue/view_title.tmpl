{{if .Flash}}
	<div class="sixteen wide column tw-mb-2">
		{{template "base/alert" .}}
	</div>
{{end}}
<div class="tw-hidden" id="issue-page-info"
	data-issue-index="{{$.Issue.Index}}"
	data-issue-dependency-search-type="{{$.IssueDependencySearchType}}"
	data-issue-repo-link="{{$.RepoLink}}"
	data-issue-repo-id="{{$.Repository.ID}}"
></div>
<div class="issue-title-header">
	{{$canEditIssueTitle := and (or .HasIssuesOrPullsWritePermission .IsIssuePoster) (not .Repository.IsArchived)}}
	<div class="issue-title" id="issue-title-display">
		<h1>
			{{ctx.RenderUtils.RenderIssueTitle .Issue.Title $.Repository}}
			<span class="index">#{{.Issue.Index}}</span>
		</h1>
		<div class="issue-title-buttons">
			{{if $canEditIssueTitle}}
			<button type="button" id="issue-title-edit-show" class="ui small basic button">{{ctx.Locale.Tr "repo.issues.edit"}}</button>
			{{end}}
			{{template "repo/issue/view_content/title_actions" .}}
		</div>
	</div>
	{{if $canEditIssueTitle}}
	<form class="ui form issue-title tw-hidden" id="issue-title-editor">
		<div class="ui input tw-flex-1">
			<input name="title" value="{{.Issue.Title}}" data-old-title="{{.Issue.Title}}" maxlength="255" autocomplete="off">
		</div>
		<div class="issue-title-buttons">
			<button type="button" class="ui small basic cancel button">{{ctx.Locale.Tr "repo.issues.cancel"}}</button>
			<button type="submit" class="ui small primary button" data-update-url="{{$.RepoLink}}/issues/{{.Issue.Index}}/title">
				{{ctx.Locale.Tr "repo.issues.save"}}
			</button>
		</div>
	</form>
	{{end}}
	<div class="forge-status-card">
		<div class="issue-title-meta flex-text-block">
		{{if .HasMerged}}
			<span class="forge-state tw-text-purple"><span class="forge-state-dot"></span> {{ctx.Locale.Tr "repo.pulls.merged"}}</span>
		{{else if .Issue.IsClosed}}
			<span class="forge-state tw-text-red"><span class="forge-state-dot"></span> {{ctx.Locale.Tr "repo.issues.closed_title"}}</span>
		{{else if .Issue.IsPull}}
			{{if .IsPullWorkInProgress}}
				<span class="forge-state tw-text-grey"><span class="forge-state-dot"></span> {{ctx.Locale.Tr "repo.issues.draft_title"}}</span>
			{{else}}
				<span class="forge-state tw-text-green"><span class="forge-state-dot"></span> {{ctx.Locale.Tr "repo.issues.open_title"}}</span>
			{{end}}
		{{else}}
			<span class="forge-state tw-text-green"><span class="forge-state-dot"></span> {{ctx.Locale.Tr "repo.issues.open_title"}}</span>
		{{end}}
		<div class="forge-status-sentence">
			{{if .Issue.IsPull}}
				{{$headHref := .HeadTarget}}
				{{if .HeadBranchLink}}
					{{$headHref = HTMLFormat `<a href="%s">%s</a> <button type="button" class="btn interact-fg" data-tooltip-content="%s" data-clipboard-text="%s">%s</button>` .HeadBranchLink $headHref (ctx.Locale.Tr "copy_branch") .HeadTarget (svg "octicon-copy" 14)}}
				{{else}}
					{{if .Issue.PullRequest.IsAgitFlow}}
						{{$headHref = HTMLFormat `%s <a href="%s" target="_blank"><span class="ui label basic tiny" data-tooltip-content="%s">AGit</span></a>` $headHref "https://docs.gitea.com/usage/agit" (ctx.Locale.Tr "repo.pull.agit_documentation")}}
					{{else if .Issue.PullRequest.HasMerged}}
						{{/* a merged head branch is usually deleted on purpose, so it is not an error */}}
						{{$headHref = HTMLFormat `<span data-tooltip-content="%s">%s</span>` (ctx.Locale.Tr "repo.pulls.head_branch_removed") $headHref}}
					{{else}}
						{{$headHref = HTMLFormat `<span class="tw-line-through" data-tooltip-content="%s">%s</span>` (ctx.Locale.Tr "form.target_branch_not_exist") $headHref}}
					{{end}}
				{{end}}
				{{$baseHref := .BaseTarget}}
				{{if .BaseBranchLink}}
					{{if .BaseBranchNotExist}}
						{{$baseHref = HTMLFormat `<span class="tw-line-through" data-tooltip-content="%s">%s</span>` (ctx.Locale.Tr "form.target_branch_not_exist") $baseHref}}
					{{else}}
						{{$baseHref = HTMLFormat `<a href="%s">%s</a>` .BaseBranchLink $baseHref}}
					{{end}}
				{{end}}
				{{if .Issue.PullRequest.HasMerged}}
					{{$mergedStr:= DateUtils.TimeSince .Issue.PullRequest.MergedUnix}}
					{{if .Issue.OriginalAuthor}}
						{{.Issue.OriginalAuthor}}
						<span class="pull-desc">{{ctx.Locale.TrN .NumCommits "repo.pulls.merged_title_desc_1" "repo.pulls.merged_title_desc" .NumCommits $headHref $baseHref $mergedStr}}</span>
					{{else}}
						{{template "shared/user/namelink" .Issue.PullRequest.Merger}}
						<span class="pull-desc">{{ctx.Locale.TrN .NumCommits "repo.pulls.merged_title_desc_1" "repo.pulls.merged_title_desc" .NumCommits $headHref $baseHref $mergedStr}}</span>
					{{end}}
					{{with .Issue.AgentIdentity ctx}}<span>· {{template "shared/user/namelink" $.Issue.Poster}} {{template "shared/agent_label" .}}</span>{{end}}
				{{else}}
					{{if .Issue.OriginalAuthor}}
						<span id="pull-desc-display" class="pull-desc">{{.Issue.OriginalAuthor}} {{ctx.Locale.TrN .NumCommits "repo.pulls.title_desc_1" "repo.pulls.title_desc" .NumCommits $headHref $baseHref}}</span>
					{{else}}
						<span id="pull-desc-display" class="pull-desc">
							{{template "shared/user/namelink" .Issue.Poster}}
							{{template "shared/agent_label" (.Issue.AgentIdentity ctx)}}
							{{ctx.Locale.TrN .NumCommits "repo.pulls.title_desc_1" "repo.pulls.title_desc" .NumCommits $headHref $baseHref}}
						</span>
					{{end}}
					{{if .Issue.PullRequest}}
					<div id="pull-desc-editor" class="tw-hidden flex-text-block tw-flex-wrap" data-target-update-url="{{$.RepoLink}}/pull/{{.Issue.Index}}/target_branch">
						{{$pr := .Issue.PullRequest}}
						{{$baseBranch := $pr.BaseBranch}}
						{{$headBranch := $pr.HeadBranch}}
						{{$baseUserName := $pr.BaseRepo.OwnerName}}
						{{$headUserName := $pr.OptionalHeadUserName ctx}}
						<div class="ui basic small button tw-pointer-events-none">
							<span class="gt-ellipsis">{{ctx.Locale.Tr "repo.pulls.compare_compare"}}: {{$.HeadTarget}}</span>
						</div>
						{{svg "octicon-arrow-right"}}
						<div class="ui floating dropdown" data-no-results="{{ctx.Locale.Tr "no_results_found"}}">
							<div class="ui basic small button">
								<span id="pull-target-branch" class="gt-ellipsis" data-base-user-name="{{$baseUserName}}" data-old-target-branch="{{$baseBranch}}" data-branch="{{$baseBranch}}" data-text-compare-base="{{ctx.Locale.Tr "repo.pulls.compare_base"}}">
									{{ctx.Locale.Tr "repo.pulls.compare_base"}}: {{$baseUserName}}:{{$baseBranch}}
								</span>
								{{svg "octicon-triangle-down" 14 "dropdown icon"}}
							</div>
							<div class="menu">
								<div class="ui icon search input">
									<i class="icon">{{svg "octicon-filter" 16}}</i>
									<input name="search" placeholder="{{ctx.Locale.Tr "repo.pulls.filter_branch"}}...">
								</div>
								<div class="scrolling menu" id="branch-select">
									{{$differentOwner := ne $baseUserName $headUserName}}
									{{range $branch := $.Branches}}
										{{$differentBranch := ne $branch $headBranch}}
										{{if or $differentOwner $differentBranch}}
											<div class="item {{if eq $baseBranch $branch}}selected{{end}}" data-branch="{{$branch}}">{{$baseUserName}}:{{$branch}}</div>
										{{end}}
									{{end}}
								</div>
							</div>
						</div>
					</div>
					{{end}}
				{{end}}
			{{else}}
				{{$createdStr:= DateUtils.TimeSince .Issue.CreatedUnix}}
				<span class="time-desc">
					{{if .Issue.OriginalAuthor}}
						{{ctx.Locale.Tr "repo.issues.opened_by_fake" $createdStr .Issue.OriginalAuthor}}
					{{else if gt .Issue.Poster.ID 0}}
						{{ctx.Locale.Tr "repo.issues.opened_by" $createdStr .Issue.Poster.HomeLink .Issue.Poster.GetDisplayName}}
						{{template "shared/agent_label" (.Issue.AgentIdentity ctx)}}
					{{else}}
						{{ctx.Locale.Tr "repo.issues.opened_by_fake" $createdStr .Issue.Poster.GetDisplayName}}
					{{end}}
					·
					{{ctx.Locale.TrN .Issue.NumComments "repo.issues.num_comments_1" "repo.issues.num_comments" .Issue.NumComments}}
					{{if .Conversation}}{{range .Conversation.Linked}} · <a href="{{.Link}}">#{{.Index}}</a>{{end}}{{end}}
				</span>
			{{end}}
		</div>
	</div>

		{{if and .Conversation .Issue.IsPull}}<div class="forge-status-summary flex-text-block tw-flex-wrap">
			<a href="#conversation-checks">{{ctx.Locale.Tr "repo.conversation.check_summary" .Conversation.Failing .Conversation.Pending .Conversation.Passing}}</a>
			<span>{{if .Conversation.ReviewActor}}{{ctx.Locale.Tr .Conversation.ReviewKey .Conversation.ReviewActor}}{{else}}{{ctx.Locale.Tr .Conversation.ReviewKey}}{{end}}</span>
			<a href="{{.Issue.Link}}/files">{{ctx.Locale.Tr "repo.conversation.files" .NumFiles}}</a>
		</div>{{end}}
	</div>
	{{if .Conversation}}{{template "repo/issue/view_content/next_step" .Conversation.Next}}{{end}}
</div>
