{{template "base/head" .}}
<div role="main" aria-label="{{if .IsSigned}}{{ctx.Locale.Tr "dashboard"}}{{else}}{{ctx.Locale.Tr "home_title"}}{{end}}" class="page-content forge-landing">
	<section class="forge-landing-hero{{if not .LandingRepos}} forge-landing-hero-solo{{end}}">
		<div class="forge-landing-pitch">
			<p class="forge-landing-kicker">{{AppName}}</p>
			<h1>{{ctx.Locale.Tr "startpage.headline"}}</h1>
			<p class="forge-landing-lead">{{ctx.Locale.Tr "startpage.lead"}}</p>
			<div class="forge-landing-actions">
				{{if .ShowRegistrationButton}}
					<a class="ui primary button" href="{{AppSubUrl}}/user/sign_up">{{ctx.Locale.Tr "startpage.create_account"}}</a>
					<a class="ui basic button" rel="nofollow" href="{{AppSubUrl}}/user/login">{{ctx.Locale.Tr "sign_in"}}</a>
				{{else}}
					<a class="ui primary button" rel="nofollow" href="{{AppSubUrl}}/user/login">{{ctx.Locale.Tr "sign_in"}}</a>
				{{end}}
				<a class="forge-landing-link" href="{{AppSubUrl}}/explore/repos">{{ctx.Locale.Tr "startpage.explore"}} {{svg "octicon-arrow-right" 14}}</a>
			</div>
		</div>
		{{if .LandingRepos}}
		<aside class="forge-landing-live" aria-labelledby="landing-live-heading">
			<h2 id="landing-live-heading">{{ctx.Locale.Tr "startpage.recent"}}</h2>
			<ul>
				{{range $repo := .LandingRepos}}
					<li>
						<a href="{{$repo.Link}}">{{svg "octicon-repo" 16}} <span>{{$repo.FullName}}</span></a>
						{{if $repo.Description}}<p>{{$repo.Description}}</p>{{end}}
						<div class="forge-landing-meta">
							{{if $repo.PrimaryLanguage}}<span><i class="color-icon" style="background-color: {{$repo.PrimaryLanguage.Color}}"></i> {{$repo.PrimaryLanguage.Language}}</span>{{end}}
							<span>{{ctx.Locale.Tr "org.repo_updated"}} {{DateUtils.TimeSince $repo.UpdatedUnix}}</span>
						</div>
					</li>
				{{end}}
			</ul>
		</aside>
		{{end}}
	</section>
	<section class="forge-landing-features" aria-label="{{ctx.Locale.Tr "startpage.features"}}">
		<article>
			{{svg "octicon-inbox" 24}}
			<h2>{{ctx.Locale.Tr "startpage.work"}}</h2>
			<p>{{ctx.Locale.Tr "startpage.work_desc"}}</p>
		</article>
		<article>
			{{svg "octicon-git-pull-request" 24}}
			<h2>{{ctx.Locale.Tr "startpage.review"}}</h2>
			<p>{{ctx.Locale.Tr "startpage.review_desc"}}</p>
		</article>
		<article>
			{{svg "octicon-dependabot" 24}}
			<h2>{{ctx.Locale.Tr "startpage.agents"}}</h2>
			<p>{{ctx.Locale.Tr "startpage.agents_desc"}}</p>
		</article>
		<article>
			{{svg "octicon-search" 24}}
			<h2>{{ctx.Locale.Tr "startpage.find"}}</h2>
			<p>{{ctx.Locale.Tr "startpage.find_desc"}}</p>
		</article>
	</section>
</div>
{{template "base/footer" .}}
